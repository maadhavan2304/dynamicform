              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Customer feedback\",\n  \"description\": \"Tell us how we did\",\n  \"is_active\": true,\n  \"is_public\": true,\n  \"allow_response_edit\": true,\n  \"fields\": [\n    {\n      \"field_key\": \"name\",\n      \"label\": \"Name\",\n      \"field_type\": \"text\",\n      \"is_required\": true\n    },\n    {\n      \"field_key\": \"plan\",\n      \"label\": \"Plan\",\n      \"field_type\": \"dropdown\",\n      \"is_required\": true,\n      \"options\": [\n        {\n          \"label\": \"Free\"\n        },\n        {\n          \"label\": \"Pro\"\n        }\n      ]\n    },\n    {\n      \"field_key\": \"why\",\n      \"label\": \"Why Pro?\",\n      \"field_type\": \"text\",\n      \"condition\": {\n        \"field_key\": \"plan\",\n        \"operator\": \"equals\",\n        \"value\": \"Pro\"\n      }\n    },\n    {\n      \"field_key\": \"score\",\n      \"label\": \"Rating\",\n      \"field_type\": \"rating\",\n      \"validation\": {\n        \"max\": 5\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('formId', j.id);",
                  "j.fields.forEach(f => pm.collectionVariables.set('field_' + f.field_key, f.id));"
                ]
              }
            }
          ]
        },
